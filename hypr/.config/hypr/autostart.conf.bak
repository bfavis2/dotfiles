# Extra autostart processes
# exec-once = uwsm app -- my-service

# $tickTick = omarchy-launch-or-focus-webapp "TickTick" "https://ticktick.com/webapp/"
$tickTick = omarchy-launch ticktick
$email = omarchy-launch-webapp "Gmail" "https://mail.google.com/"
$readwiseReader = omarchy-launch-or-focus-webapp "Readwise Reader" "https://read.readwise.io/new/"
$readwiseDaily = omarchy-launch-or-focus-webapp "Readwise Daily" "https://readwise.io/dailyreview"

# windowrulev2 = workspace 2 silent, class:(chromium)
# windowrulev2 = workspace 2, class:(.*read\.readwise.*)
exec-once = [workspace 1 silent] $email
exec-once = [workspace 1 silent] $tickTick
exec-once = [workspace 2 silent] omarchy-launnch "Discord"
exec-once = [workspace 2 silent] omarchy-launnch "Google Message"
exec-once = [workspace 3 silent] omarchy-launch-browser
exec-once = [workspace 4 silent] uwsm app -- obsidian -disable-gpu --enable-wayland-ime
exec-once = [workspace 6 silent] omarchy-launch-browser
exec-once = [workspace 7 silent] $terminal
exec-once = [workspace 8 silent] $terminal
exec-once = [workspace 9 silent] $readwiseReader
